model_cache/my_model.h5 filter=lfs diff=lfs merge=lfs -text

# Normalize line endings
* text=auto
*.py text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.env text eol=lf
*.sh text eol=lf

# Binary files — no conversion
*.png binary
*.jpg binary
*.jpeg binary
*.jfif binary
*.gif binary
*.pdf binary
*.pt binary
*.pth binary
*.h5 binary
